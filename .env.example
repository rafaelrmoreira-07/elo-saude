# Copie este arquivo para .env.local. O .env.local fica fora do git.
#
# Demonstração: cole uma chave temporária e restrita da Gemini (veja o README).
NEXT_PUBLIC_GEMINI_API_KEY=
#
# Lojas (App Store e Google Play): a chave fica no servidor (server/ai-proxy).
# Preencha o endereço dele e deixe a linha de cima vazia.
NEXT_PUBLIC_AI_PROXY_URL=
